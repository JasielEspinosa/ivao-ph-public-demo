{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "version:stamp": "node scripts/generate-version.mjs",
    "prestart": "npm run version:stamp",
    "prebuild": "npm run version:stamp",
    "prewatch": "npm run version:stamp",
    "pretest": "npm run version:stamp",
    "start:dev": "npm run format:check && npm run start:auto-restart",
    "start:auto-restart": "ng serve -o",
    "start": "ng serve",
    "build": "ng build",
    "format:check": "prettier --check \"src/app/**/*.{ts,html,css}\"",
    "format": "prettier --write \"src/app/**/*.{ts,html,css}\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "overrides": {
    "exceljs": {
      "archiver": "^8.0.0",
      "unzipper": "^0.12.5",
      "fast-csv": "^5.0.7",
      "uuid": "^11.1.0"
    },
    "minimatch": "^11.0.9"
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "bootstrap": "^5.3.8",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
